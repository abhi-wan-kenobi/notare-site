---
import Base from "../layouts/Base.astro";

const repo = "https://github.com/abhi-wan-kenobi/notare";
const releases = `${repo}/releases/latest`;
const version = "0.7.2";
const tour = [
  { image: "meeting-summary", label: "01 / During & after", title: "Start with your notes.", text: "Write while you listen. Use the transcript to enhance your rough notes, review decisions, and jump through the recording by chapter.", alt: "Meeting summary showing written notes, chapters, and a decision" },
  { image: "series", label: "02 / Next time", title: "Pick up where you left off.", text: "Open a recurring meeting’s series to see carried-over actions, what changed since last time, and the previous meetings. Prepare the next one with that context in your notes.", alt: "Q4 Launch Sync series with carried-over actions and a meeting timeline" },
  { image: "ask", label: "03 / Across meetings", title: "Ask your meeting history.", text: "Open Ask Notare alongside your notes. Search across meetings, narrow the scope, and use recipes for questions you ask often. Connect a local model or your own AI provider.", alt: "Ask Notare side panel answering a question about an earlier engineering meeting" },
  { image: "action-items", label: "04 / Follow through", title: "Keep the next steps in view.", text: "Review action items across your meetings, with owners and due dates. Filter for what is open, yours, overdue, or done.", alt: "Action items grouped by meeting, with assignees and due dates" },
];
const gallery = [
  { image: "meeting-transcript", title: "Read the transcript", alt: "Meeting transcript with named speakers" },
  { image: "calendar", title: "Plan your week", alt: "Calendar week view with meetings and a mini month" },
  { image: "palette", title: "Find it with Ctrl+K or ⌘K", alt: "Command palette with actions, settings, and meeting search" },
  { image: "settings", title: "Choose your speech model", alt: "AI and Speech settings with downloadable local transcription models" },
];
---

<Base
  title="Notare | Meeting notes that stay with you"
  description="Record meetings, transcribe locally, and turn your notes into decisions and next steps. Open-source desktop app for macOS, Windows, and Linux."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <a class="release-link" href={`${repo}/releases/tag/v${version}`}>Notare {version} · A new look, built around your notes <span aria-hidden="true">↗</span></a>
      <h1 id="hero-title">Your meetings.<br />Your notes. <em>Your machine.</em></h1>
      <p class="sub">Record the conversation. Write what matters. Turn it into a summary, decisions, and next steps, with your notes saved as plain Markdown.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#download">Download Notare <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#tour">Take a look <span aria-hidden="true">↘</span></a>
      </div>
      <p class="meta-line">macOS · Windows · Linux <span aria-hidden="true">/</span> Free & open source <span aria-hidden="true">/</span> No Notare account required</p>
      <figure class="hero-product">
        <a href="/assets/screenshots/home.png" aria-label="View the full-size Notare Home screenshot">
          <img src="/assets/screenshots/home.png" alt="Notare Home with upcoming meetings, recent notes, and open action items" width="1440" height="900" fetchpriority="high" />
        </a>
        <figcaption>Home brings today’s meetings, recent notes, and open actions together. Actual app captures with fictional demo data.</figcaption>
      </figure>
    </div>
  </section>

  <section class="trust-strip" aria-label="How Notare handles your meetings">
    <div class="wrap">
      <p><strong>No meeting bot.</strong> Capture system audio and your microphone on your computer.</p>
      <p><strong>Local by default.</strong> Audio leaves your machine only when you choose a remote provider.</p>
      <p><strong>Keep your files.</strong> Save notes as Markdown in a folder you choose, including an Obsidian vault.</p>
    </div>
  </section>

  <section class="band" id="tour" aria-labelledby="tour-title">
    <div class="wrap">
      <p class="kicker">A meeting, from start to next steps</p>
      <h2 class="section-title" id="tour-title">More than a transcript.</h2>
      <p class="section-lede">Your notes, the conversation behind them, and the work that comes next, in one desktop app.</p>
      <div class="product-tour">
        {tour.map((item) => (
          <article class="product-row">
            <div class="product-copy">
              <p class="eyebrow">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
            <a class="product-shot" href={`/assets/screenshots/${item.image}.png`} aria-label={`View full-size screenshot: ${item.alt}`}>
              <img src={`/assets/screenshots/${item.image}.png`} alt={item.alt} width={item.image === "ask" ? 1799 : 1440} height="900" loading="lazy" decoding="async" />
            </a>
          </article>
        ))}
      </div>
      <div class="screen-grid">
        {gallery.map((item) => (
          <figure>
            <a class="product-shot" href={`/assets/screenshots/${item.image}.png`} aria-label={`View full-size screenshot: ${item.alt}`}>
              <img src={`/assets/screenshots/${item.image}.png`} alt={item.alt} width="1440" height="900" loading="lazy" decoding="async" />
            </a>
            <figcaption>{item.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="band workspace-band" id="features" aria-labelledby="features-title">
    <div class="wrap workspace-grid">
      <div>
        <p class="kicker">Your setup, your choice</p>
        <h2 class="section-title" id="features-title">Work locally.<br />Connect what you need.</h2>
        <p class="section-lede">Notare is free under the MIT license. There is no Notare subscription. Services you connect may charge their own fees.</p>
        <a class="text-link" href={repo}>Read the source <span aria-hidden="true">↗</span></a>
      </div>
      <dl class="capabilities">
        <div><dt>Dictation, anywhere</dt><dd>Hold a hotkey, speak, and release to type at your cursor, with output cleanup options.</dd></div>
        <div><dt>Local speech & AI</dt><dd>Download an on-device transcription model. Connect Ollama, LM Studio, or a supported provider with your own API key for AI features.</dd></div>
        <div><dt>Calendar & follow-up</dt><dd>Connect Google or Outlook calendars. Prepare meeting notes and draft follow-up emails. Gmail draft access is opt-in.</dd></div>
        <div><dt>Device sync <span class="badge">Preview</span></dt><dd>Pair desktops with a QR code and confirmation code for peer-to-peer sync. Optional and off by default.</dd></div>
        <div><dt>Tools for your agents</dt><dd>Use the built-in MCP server to give compatible clients access to Notare’s meeting tools. <a href={`${repo}/blob/main/docs/MCP.md`}>MCP setup</a></dd></div>
        <div><dt>A self-hosted STT server</dt><dd>Run transcription on another machine with Docker images for CPU, Vulkan, CUDA, or ROCm. Configure the server and connect Notare to its URL. <a href={`${repo}/blob/main/docs/stt-server-design.md`}>Server setup</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="band dark-preview" aria-labelledby="dark-title">
    <div class="wrap">
      <div class="section-heading-row">
        <div><p class="kicker">After hours, too</p><h2 class="section-title" id="dark-title">Light by default. Dark when you want.</h2></div>
        <p>Switch themes in Settings or the command palette.</p>
      </div>
      <a class="product-shot" href="/assets/screenshots/home-dark.png" aria-label="View full-size dark theme screenshot"><img src="/assets/screenshots/home-dark.png" alt="Notare Home in dark theme" width="1440" height="900" loading="lazy" decoding="async" /></a>
    </div>
  </section>

  <section class="band" id="download" aria-labelledby="download-title">
    <div class="wrap">
      <p class="kicker">Get started</p>
      <h2 class="section-title" id="download-title">Make room for your next meeting.</h2>
      <p class="section-lede">Current stable release: {version}. Choose your platform on GitHub Releases.</p>
      <div class="downloads">
        <article><h3>macOS</h3><p class="format">Apple Silicon · .dmg</p><p>Developer ID signed and notarized by Apple. Intel Macs need a source build.</p><a class="btn btn-primary" href={releases}>Get the macOS installer <span aria-hidden="true">↗</span></a></article>
        <article><h3>Windows</h3><p class="format">Windows 10/11 · x64 · .msi</p><p>The installer is unsigned. SmartScreen may warn on first run: choose More info → Run anyway if you trust the download.</p><a class="btn btn-primary" href={releases}>Get the Windows installer <span aria-hidden="true">↗</span></a></article>
        <article><h3>Linux</h3><p class="format">x64 · AppImage or .deb</p><p>Use the AppImage for in-app updates. For Debian or Ubuntu packages, download a new .deb when you update.</p><a class="btn btn-primary" href={releases}>Get the Linux download <span aria-hidden="true">↗</span></a></article>
      </div>
      <p class="download-note">In-app updates: macOS, Windows, and Linux AppImage. <a href={`${repo}/blob/main/docs/BUILDING.md`}>Build from source</a> · <a href={`${repo}/releases/tag/v${version}`}>Release notes</a></p>
      <p class="recovery-note"><strong>Already on 0.7.0?</strong> If you see “Something went wrong”, install the latest release over it. That release’s main-window crash could also prevent the in-app updater from opening.</p>
    </div>
  </section>

  <section class="band" id="questions" aria-labelledby="questions-title">
    <div class="wrap faq-layout">
      <div><p class="kicker">Before you start</p><h2 class="section-title" id="questions-title">A few practical answers.</h2></div>
      <div class="faq-list">
        <details><summary>Does anything leave my computer?</summary><p>You can transcribe locally and use local AI models. When you configure a remote speech server, AI provider, calendar, or email integration, Notare sends the data needed for that feature to that service. Notare has no telemetry. <a href="/privacy">Read the privacy policy.</a></p></details>
        <details><summary>Do I need an account or API key?</summary><p>You do not need a Notare account. Local transcription needs a downloaded speech model. AI summaries and chat need a configured AI backend, which can be local or remote. Calendar and email connections need sign-in to those services.</p></details>
        <details><summary>Can I keep my Obsidian vault?</summary><p>Yes. Choose your vault, or another folder, for Markdown notes. Notare keeps its app state locally; you can open the Markdown files in other editors.</p></details>
        <details><summary>What should I know about Google sign-in?</summary><p>The bundled Google OAuth app is not yet verified by Google, so you may see an unverified-app warning. <a href={`${repo}/blob/main/docs/GOOGLE-CALENDAR.md`}>Read the calendar setup guide</a> before connecting.</p></details>
        <details><summary>Are there mobile apps?</summary><p>Not yet. The releases here are desktop apps for macOS, Windows, and Linux. Follow the <a href={`${repo}/issues`}>issue tracker</a> for future work.</p></details>
      </div>
    </div>
  </section>
</Base>
