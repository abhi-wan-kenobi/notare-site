---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Notare" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Notare: local-first meeting notes, summaries, and next steps." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/assets/notare-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">
          <img class="brand-logo" src="/assets/notare-logo.png" alt="" width="30" height="30" />
          Notare
        </a>
        <nav class="main" aria-label="Main">
          <a class="desktop-nav" href="/#tour">Product</a>
          <a class="desktop-nav" href="https://github.com/abhi-wan-kenobi/notare/issues">Roadmap</a>
          <a href="https://github.com/abhi-wan-kenobi/notare">GitHub</a>
          <a class="btn btn-primary" href="/#download">Download</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <span>Notare — free & open source · MIT</span>
        <nav aria-label="Footer">
          <a href="/#tour">Product</a>
          <a href="https://github.com/abhi-wan-kenobi/notare/issues">Roadmap</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="https://github.com/abhi-wan-kenobi/notare">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
